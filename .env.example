# Copy to .env in your deployment environment; do not commit real secrets.
SUMS_ENVIRONMENT=development
SUMS_DATA_DIR=backend/data
SUMS_CORS_ORIGINS=http://localhost:5173
SUMS_ALLOWED_HOSTS=localhost,127.0.0.1
SUMS_SESSION_MINUTES=30
SUMS_MAX_REQUEST_BYTES=16384
# Generate a long random value for this. It authorises the one-time first admin creation.
SUMS_BOOTSTRAP_KEY=replace-with-a-long-random-secret
# Use true only when the frontend and API are served over HTTPS.
SUMS_COOKIE_SECURE=false
