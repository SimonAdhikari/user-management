# Use a RELATIVE API URL so the built app works from ANY origin —
# localhost, your LAN IP, or a public Cloudflare tunnel domain.
# The vite dev/preview server proxies /api -> backend (8000) and /media -> storage (8001).
# Only set an absolute URL (e.g. http://127.0.0.1:8000) for local dev WITHOUT the proxy.
VITE_API_URL=/api
